# Copy to .env and fill in what you need. The server reads plain environment variables:
#   set -a; source .env; set +a; npm run dev

# Postgres (docker compose up -d). Leave empty to keep data in memory only.
DATABASE_URL=postgres://tuban:tuban@localhost:5432/tuban

# Claude agents. Without a key the office runs in demo mode.
ANTHROPIC_API_KEY=

# Optional
# TU_BAN_MODE=demo
# CLAUDE_MODEL=claude-opus-5-5
# MAX_BUDGET_USD=1
# MAX_TURNS=30
# TU_BAN_WORKDIR=workspace
