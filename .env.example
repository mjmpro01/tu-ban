# Copy to .env and fill in what you need. The server reads plain environment variables:
#   set -a; source .env; set +a; npm run dev

# Postgres (docker compose up -d). Leave empty to keep data in memory only.
DATABASE_URL=postgres://tuban:tuban@localhost:5432/tuban

# Claude agents. Without a key (or 9router) the office runs in demo mode.
ANTHROPIC_API_KEY=

# 9router gateway (https://github.com/decolua/9router): Claude agents call it instead of
# api.anthropic.com, and Mem0 uses its OpenAI-compatible /v1 API. ANTHROPIC_API_KEY is then not needed.
# NINEROUTER_URL=http://localhost:20128
# NINEROUTER_KEY=

# Shared memory. Without MEM0_URL: keyword search in Postgres (no extra service).
# With Mem0 (docker compose --profile memory up -d): semantic search + fact extraction.
# MEM0_URL=http://localhost:8888
# MEM0_API_KEY=                                   # same value as in docker compose
# MEM0_NINEROUTER_URL=http://host.docker.internal:20128   # 9router as seen from the Mem0 container
# MEMORY_LLM_MODEL=                               # a 9router model id, for extracting facts
# MEMORY_EMBED_URL=http://tei                     # embedding server as seen from Mem0 (compose service)
# MEMORY_EMBED_MODEL=AITeamVN/Vietnamese_Embedding
# MEMORY_EMBED_DIMS=1024
# MEM0_CONFIGURE=1                                # 0 = do not send model settings to Mem0

# Accounts: creates the first admin when there is no account yet
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# PUBLIC_URL=https://office.example.com

# Notifications (secrets stay here, never in the database)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=

# Time zone for daily stats and the daily budget
# TZ=Asia/Ho_Chi_Minh

# Optional
# TU_BAN_MODE=demo
# CLAUDE_MODEL=claude-opus-5-5
# MAX_BUDGET_USD=1
# DAILY_BUDGET_USD=0
# MAX_TURNS=30
# TU_BAN_WORKDIR=workspace
